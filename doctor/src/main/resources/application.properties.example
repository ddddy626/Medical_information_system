# =============================================================================
# doctor-codex 配置模板（本文件可安全上传，不含任何真实密码 / 密钥）
#
# 使用方法：
#   1. 在本目录（doctor/src/main/resources）下复制本文件，重命名为 application.properties
#       Windows:      copy application.properties.example application.properties
#       macOS/Linux:  cp application.properties.example application.properties
#   2. 填写下面所有标注 <<必填>> 的配置项（模板中的值均为空，必须自行填写）。
#   3. application.properties 已被 .gitignore 排除，请勿提交到 Git。
#
# 说明：
#   - 敏感值可直接填写明文；如需加密存储，可用 Jasypt 生成 ENC(...) 密文，
#     此时必须设置环境变量 JASYPT_PWD（与加密时使用的主密码一致），否则无法解密。
#   - 形如 ${XXX:默认值} 的写法表示优先读取同名环境变量，读不到时使用冒号后的默认值。
# =============================================================================

# -----------------------------------------------------------------------------
# [仅加密时需要] Jasypt 主密码：用于解密 ENC(...) 密文
#   全部配置使用明文时本项可留空；一旦使用 ENC(...) 则必须填写，
#   或改用环境变量 JASYPT_PWD / JASYPT_ENCRYPTOR_PASSWORD 提供。
# -----------------------------------------------------------------------------
jasypt.encryptor.password=
jasypt.encryptor.algorithm=PBEWithHMACSHA512AndAES_256
jasypt.encryptor.iv-generator-classname=org.jasypt.iv.RandomIvGenerator
jasypt.encryptor.property.prefix=ENC(
jasypt.encryptor.property.suffix=)

# -----------------------------------------------------------------------------
# 服务端口与上下文路径（无需修改，除非端口被占用）
# 访问地址：http://localhost:8081/doctor/
# -----------------------------------------------------------------------------
server.port=8081
server.servlet.context-path=/doctor

# -----------------------------------------------------------------------------
# <<必填>> MySQL 数据源
#   url 中的端口须与本机 MySQL 实际监听端口一致（示例为 3306，若本机是 3309 请自行修改）
#   也可用环境变量 MYSQL_HOST / MYSQL_PORT / MYSQL_USER / MYSQL_PASSWORD 覆盖
# -----------------------------------------------------------------------------
spring.datasource.driver-class-name=com.mysql.cj.jdbc.Driver
spring.datasource.url=jdbc:mysql://${MYSQL_HOST:localhost}:${MYSQL_PORT:3306}/hospital_db?useUnicode=true&characterEncoding=UTF-8&connectionCollation=utf8mb4_unicode_ci&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
spring.datasource.username=
spring.datasource.password=

spring.datasource.type=org.apache.commons.dbcp2.BasicDataSource
spring.datasource.dbcp2.max-wait-millis=60000
spring.datasource.dbcp2.max-total=20
spring.datasource.dbcp2.max-idle=2
spring.datasource.dbcp2.default-auto-commit=false
spring.datasource.dbcp2.min-idle=1

# -----------------------------------------------------------------------------
# MyBatis / 日志 / 静态资源（无需修改）
# -----------------------------------------------------------------------------
mybatis.type-aliases-package=com.dyh.doctor.domain
mybatis.mapper-locations=classpath*:mapper/*Mapper.xml
logging.level.com.dyh.doctor=INFO
mybatis.configuration.log-impl=org.apache.ibatis.logging.stdout.StdOutImpl
spring.mvc.pathmatch.matching-strategy=ANT_PATH_MATCHER

spring.servlet.multipart.max-file-size=10MB
spring.servlet.multipart.max-request-size=10MB

# -----------------------------------------------------------------------------
# <<必填>> Redis（验证码、分布式锁、可选会话存储）
#   本机 Redis 未设密码时 password 留空即可
#   也可用环境变量 REDIS_HOST / REDIS_PORT / REDIS_PASSWORD 覆盖
# -----------------------------------------------------------------------------
spring.redis.host=localhost
spring.redis.port=6379
spring.redis.password=
spring.redis.timeout=3000ms
spring.redis.lettuce.pool.max-active=8
spring.redis.lettuce.pool.max-idle=8
spring.redis.lettuce.pool.min-idle=0
spring.redis.lettuce.pool.max-wait=-1ms
spring.session.store-type=none
spring.session.redis.namespace=doctor:session
server.servlet.session.timeout=30m

# -----------------------------------------------------------------------------
# <<必填>> QQ 邮箱 SMTP（注册 / 找回密码的验证码邮件）
#   username 填完整邮箱地址；password 填 SMTP 授权码（不是 QQ 登录密码）
#   授权码获取：QQ邮箱 -> 设置 -> 账户 -> 开启 SMTP 服务
# -----------------------------------------------------------------------------
spring.mail.host=smtp.qq.com
spring.mail.port=465
spring.mail.username=
spring.mail.password=
spring.mail.properties.mail.smtp.auth=true
spring.mail.properties.mail.smtp.ssl.enable=true
spring.mail.properties.mail.smtp.ssl.trust=smtp.qq.com
spring.mail.properties.mail.smtp.connectiontimeout=15000
spring.mail.properties.mail.smtp.timeout=15000
spring.mail.properties.mail.smtp.writetimeout=15000
spring.mail.default-encoding=UTF-8

# -----------------------------------------------------------------------------
# Sentinel 限流（AI 接口流控，无需修改）
# -----------------------------------------------------------------------------
sentinel.dashboard.server=${SENTINEL_DASHBOARD:localhost:8080}
sentinel.ai.qps=5

# -----------------------------------------------------------------------------
# <<必填>> DeepSeek AI（智能问诊 / 辅助建议）
#   key 获取：https://platform.deepseek.com
# -----------------------------------------------------------------------------
deepseek.api.url=https://api.deepseek.com/v1/chat/completions
deepseek.model=deepseek-v4-flash
deepseek.api.key=

# -----------------------------------------------------------------------------
# <<必填>> 百度语音识别（语音输入，极速版）
#   控制台：https://console.bce.baidu.com/ai/
# -----------------------------------------------------------------------------
baidu.voice.app-id=
baidu.voice.asr-url=https://vop.baidu.com/pro_api
baidu.voice.dev-pid=80001
baidu.voice.api-key=
baidu.voice.secret-key=

# -----------------------------------------------------------------------------
# <<必填>> 百度图像识别 OCR（病历 / 检查单文字提取）
# -----------------------------------------------------------------------------
baidu.image.app-id=
baidu.ocr.url=https://aip.baidubce.com/rest/2.0/ocr/v1/general_basic
baidu.image.api-key=
baidu.image.secret-key=

# -----------------------------------------------------------------------------
# <<必填>> 和风天气（首页天气与健康提示）
#   api.host 是控制台分配的专属域名（不是密钥）；key 与 host 均需填写
#   控制台：https://console.qweather.com/setting
# -----------------------------------------------------------------------------
hefeng.api.key=
hefeng.api.host=
hefeng.location-id=101010100
hefeng.default-city=\u5317\u4eac

# -----------------------------------------------------------------------------
# 业务参数（无需修改）
# -----------------------------------------------------------------------------
# 医生每日号源上限（剩余号 = 上限 - 当日已挂号数）
register.daily-limit=50

# -----------------------------------------------------------------------------
# 激活的 profile：local 表示会额外加载同目录的 application-local.properties（本机覆盖，不提交）
# -----------------------------------------------------------------------------
spring.profiles.active=${SPRING_PROFILES_ACTIVE:local}
