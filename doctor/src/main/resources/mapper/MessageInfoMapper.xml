<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dyh.doctor.mapper.MessageInfoMapper">

    <resultMap id="messageInfoMap" type="com.dyh.doctor.domain.MessageInfoEntity">
        <result column="msg_id" property="msgId" />
        <result column="msg_content" property="msgContent" />
        <result column="msg_time" property="msgTime" />
        <result column="sender_id" property="senderId" />
        <result column="receiver_id" property="receiverId" />
        <result column="reply_content" property="replyContent" />
        <result column="msg_type" property="msgType" />
    </resultMap>

    <sql id="baseSql">
        SELECT
            message_info.msg_id, message_info.msg_content, message_info.msg_time, message_info.sender_id, message_info.receiver_id, message_info.reply_content, message_info.msg_type
        FROM message_info
        WHERE 1 = 1 
    </sql>

    <sql id="condition">
        <if test="messageInfo.msgId != null">
             and message_info.msg_id = #{messageInfo.msgId}
        </if>
        <if test="messageInfo.msgContent != null and messageInfo.msgContent != ''">
             and message_info.msg_content LIKE concat('%', #{messageInfo.msgContent}, '%')
        </if>
        <if test="messageInfo.msgTime != null and messageInfo.msgTime != ''">
             and message_info.msg_time LIKE concat('%', #{messageInfo.msgTime}, '%')
        </if>
        <if test="messageInfo.senderId != null">
             and message_info.sender_id = #{messageInfo.senderId}
        </if>
        <if test="messageInfo.receiverId != null">
             and message_info.receiver_id = #{messageInfo.receiverId}
        </if>
        <if test="messageInfo.msgType != null">
             and message_info.msg_type = #{messageInfo.msgType}
        </if>
    </sql>

    <select id="queryById" resultMap="messageInfoMap">
        <include refid="baseSql"></include>
        AND message_info.msg_id = #{msgId}
    </select>

    <select id="queryAllByLimit" resultMap="messageInfoMap">
        <include refid="baseSql"></include>
        <include refid="condition"></include>
        order by msg_id desc
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(1)
        from (
        <include refid="baseSql"></include>
        <include refid="condition"></include> ) t
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="msgId">
        insert into message_info(msg_content, msg_time, sender_id, receiver_id, reply_content, msg_type)
        values(#{msgContent}, #{msgTime}, #{senderId}, #{receiverId}, #{replyContent}, #{msgType})
    </insert>

    <update id="update">
        update message_info
        <set>
            <if test="msgContent != null and msgContent != ''">
                msg_content = #{msgContent},
            </if>
            <if test="msgTime != null and msgTime != ''">
                msg_time = #{msgTime},
            </if>
            <if test="senderId != null">
                sender_id = #{senderId},
            </if>
            <if test="receiverId != null">
                receiver_id = #{receiverId},
            </if>
            <if test="replyContent != null and replyContent != ''">
                reply_content = #{replyContent},
            </if>
            <if test="msgType != null">
                msg_type = #{msgType},
            </if>
        </set>
        WHERE msg_id = #{msgId}
    </update>

    <delete id="deleteById">
        DELETE FROM message_info WHERE msg_id = #{msgId}
    </delete>
</mapper>