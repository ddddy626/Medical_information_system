<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.dyh.doctor.mapper.UserInfoMapper">

    <resultMap id="userInfoMap" type="com.dyh.doctor.domain.UserInfoEntity">
        <result column="user_id" property="userId" />
        <result column="username" property="username" />
        <result column="password" property="password" />
        <result column="real_name" property="realName" />
        <result column="phone" property="phone" />
        <result column="email" property="email" />
        <result column="role_type" property="roleType" />
        <result column="status" property="status" />
        <result column="create_time" property="createTime" />
    </resultMap>

    <sql id="baseSql">
        SELECT
            user_info.user_id, user_info.username, user_info.password, user_info.real_name, user_info.phone, user_info.email, user_info.role_type, user_info.status, user_info.create_time
        FROM user_info
        WHERE 1 = 1 
    </sql>

    <sql id="condition">
        <if test="userInfo.userId != null">
             and user_info.user_id = #{userInfo.userId}
        </if>
        <if test="userInfo.username != null and userInfo.username != ''">
             and user_info.username LIKE concat('%', #{userInfo.username}, '%')
        </if>
        <if test="userInfo.password != null and userInfo.password != ''">
             and user_info.password LIKE concat('%', #{userInfo.password}, '%')
        </if>
        <if test="userInfo.realName != null and userInfo.realName != ''">
             and user_info.real_name LIKE concat('%', #{userInfo.realName}, '%')
        </if>
        <if test="userInfo.phone != null and userInfo.phone != ''">
             and user_info.phone LIKE concat('%', #{userInfo.phone}, '%')
        </if>
        <if test="userInfo.email != null and userInfo.email != ''">
             and user_info.email LIKE concat('%', #{userInfo.email}, '%')
        </if>
        <if test="userInfo.roleType != null">
             and user_info.role_type = #{userInfo.roleType}
        </if>
        <if test="userInfo.status != null">
             and user_info.status = #{userInfo.status}
        </if>
        <if test="userInfo.createTime != null and userInfo.createTime != ''">
             and user_info.create_time LIKE concat('%', #{userInfo.createTime}, '%')
        </if>
    </sql>

    <select id="queryById" resultMap="userInfoMap">
        <include refid="baseSql"></include>
        AND user_info.user_id = #{userId}
    </select>

    <select id="queryAllByLimit" resultMap="userInfoMap">
        <include refid="baseSql"></include>
        <include refid="condition"></include>
        order by user_id desc
        limit #{pageable.offset}, #{pageable.pageSize}
    </select>

    <select id="count" resultType="java.lang.Long">
        select count(1)
        from (
        <include refid="baseSql"></include>
        <include refid="condition"></include> ) t
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="userId">
        insert into user_info(username, password, real_name, phone, email, role_type, status, create_time)
        values(#{username}, #{password}, #{realName}, #{phone}, #{email}, #{roleType}, #{status}, #{createTime})
    </insert>

    <update id="update">
        update user_info
        <set>
            <if test="username != null and username != ''">
                username = #{username},
            </if>
            <if test="password != null and password != ''">
                password = #{password},
            </if>
            <if test="realName != null and realName != ''">
                real_name = #{realName},
            </if>
            <if test="phone != null and phone != ''">
                phone = #{phone},
            </if>
            <if test="email != null and email != ''">
                email = #{email},
            </if>
            <if test="roleType != null">
                role_type = #{roleType},
            </if>
            <if test="status != null">
                status = #{status},
            </if>
            <if test="createTime != null and createTime != ''">
                create_time = #{createTime},
            </if>
        </set>
        WHERE user_id = #{userId}
    </update>

    <delete id="deleteById">
        DELETE FROM user_info WHERE user_id = #{userId}
    </delete>

    <select id="queryByUsername" resultMap="userInfoMap">
        <include refid="baseSql"></include>
        and user_info.username = #{username}
        limit 1
    </select>

    <select id="queryByEmail" resultMap="userInfoMap">
        <include refid="baseSql"></include>
        and lower(user_info.email) = #{email}
        limit 1
    </select>

    <select id="queryByLogin" resultMap="userInfoMap">
        <include refid="baseSql"></include>
        and user_info.username = #{username}
        and user_info.password = #{password}
        and user_info.role_type = #{roleType}
        and (user_info.status is null or user_info.status = 1)
        limit 1
    </select>
</mapper>

